# Backend
MONGODB_URI=mongodb://admin:password@localhost:27017/todo-app?authSource=admin
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Logs -> Elasticsearch (data streams logs-todo.*); false desliga o envio
ELASTICSEARCH_NODE=http://localhost:9200
LOG_TO_ELASTICSEARCH=true
CORS_ORIGINS=http://localhost:3010,http://localhost:3001,http://localhost:5601
# Tracing (OpenTelemetry -> Tempo); true desliga
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SDK_DISABLED=false

# Frontend
REACT_APP_API_URL=http://localhost:3000
REACT_APP_LOG_LEVEL=debug
REACT_APP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
REACT_APP_OTEL_ENABLED=true
# Em dev, cada chamada à API imprime no console o link do trace neste Grafana
REACT_APP_GRAFANA_URL=http://localhost:3030

# Kibana Plugin
BACKEND_URL=http://localhost:3010/api/todos
ELASTICSEARCH_HOSTS=http://localhost:9200
